{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/ChatGPT/schemas/proposal.schema.json",
  "title": "QSOL ChatGPT Proposed Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": {"const": "qsol-chatgpt-proposal/1"},
    "kind": {"type": "string", "minLength": 1, "maxLength": 128},
    "args": {"type": "object", "default": {}},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 256, "default": "agent"},
    "credential_handles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^cred:[A-Za-z0-9._:-]+$"},
      "default": []
    }
  }
}
