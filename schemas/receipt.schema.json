{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/ChatGPT/schemas/receipt.schema.json",
  "title": "QSOL ChatGPT Action Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "action_id", "kind", "decision", "status", "output", "error", "recorded_at"],
  "properties": {
    "schema_version": {"const": "qsol-chatgpt-receipt/1"},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allow", "require_approval", "deny"]},
    "status": {"enum": ["denied", "approval_required", "unsupported", "simulated", "completed", "failed"]},
    "output": {"type": ["object", "null"]},
    "error": {"type": ["string", "null"]},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
