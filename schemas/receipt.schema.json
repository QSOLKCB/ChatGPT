{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/ChatGPT/schemas/receipt.schema.json",
  "title": "QSOL ChatGPT Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "action_id", "kind", "decision", "status"],
  "properties": {
    "schema_version": {"const": "qsol-chatgpt-receipt/2"},
    "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allow", "approval_required", "deny"]},
    "status": {"enum": ["denied", "approval_required", "simulated", "completed", "failed", "unsupported"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stdout_sha256", "stdout_bytes", "stderr_sha256", "stderr_bytes"],
      "properties": {
        "exit_code": {"type": ["integer", "null"]},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "error_code": {"type": "string", "minLength": 1}
  }
}
