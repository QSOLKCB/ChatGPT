{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/ChatGPT/schemas/action.schema.json",
  "title": "QSOL ChatGPT Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "kind", "args", "requested_by"],
  "properties": {
    "schema_version": {"const": "qsol-chatgpt-action/1"},
    "action_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"type": "string", "minLength": 1},
    "args": {"type": "object"},
    "requested_by": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "shell.exec"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {"type": "string", "maxLength": 16384}
              }
            }
          }
        }
      }
    }
  ]
}
